<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="LogBackConsole" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{dd.MM.yyyy HH:mm:ss.SSS} [%thread] %-5level %logger{20} -%kvp- %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="LogBackConsole"/>
    </root>
</configuration>
